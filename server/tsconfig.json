{
  "compilerOptions": {
    "target": "esnext",
		"moduleDetection": "force",
    "module": "preserve",
    "rewriteRelativeImportExtensions": true,
		"resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
		"esModuleInterop": true,
		"isolatedModules": true,
    "strict": true,
		"allowJs": true,
    "skipLibCheck": true,
    "paths": { "@shared/*": ["../shared/*"] }
  }
}